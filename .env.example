# ── Required ──────────────────────────────────────────────────────────────────
# Groq free-tier API key — get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# MongoDB connection string — used to track async download jobs
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname

# JWT secret for auth tokens (any long random string)
JWT_SECRET=change_me_to_a_random_secret

# ── GitHub Actions download offloading ────────────────────────────────────────
# Personal Access Token with "repo" scope — github.com/settings/tokens
GH_PAT=ghp_your_token_here

# Your GitHub username and repo name
GITHUB_OWNER=shubechavan
GITHUB_REPO=yDownloaderandSummarizer

# Random secret shared with GitHub Actions to verify callbacks
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALLBACK_SECRET=change_me_to_a_random_secret

# Public URL of this app on Render (no trailing slash)
RENDER_URL=https://your-app.onrender.com

# ── Optional: binary paths (defaults work on Windows dev / Docker) ─────────────
# Linux Docker image sets these automatically via Dockerfile ENV
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=ffmpeg

# Windows local dev (auto-detected if yt-dlp.exe is in project root)
# YTDLP_PATH=C:\path\to\yt-dlp.exe
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# ── Server ────────────────────────────────────────────────────────────────────
# Port to listen on (Render sets this to 10000 automatically)
# PORT=5000
